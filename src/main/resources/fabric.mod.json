{
  "schemaVersion": 1,
  "id": "vertex",
  "version": "${version}",
  "name": "Vertex",
  "description": "OptiFine-format shader packs on Minecraft's native Vulkan renderer.",
  "authors": ["ir"],
  "license": "LGPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": [
      { "adapter": "kotlin", "value": "dev.vertex.Vertex" }
    ]
  },
  "mixins": ["vertex.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.13.13+kotlin.2.4.10",
    "minecraft": ">=26.2"
  }
}
